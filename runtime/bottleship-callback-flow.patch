diff --git a/src/worker/core/diagnostics/callback-flow.ts b/src/worker/core/diagnostics/callback-flow.ts
new file mode 100644
index 0000000..8567f05
--- /dev/null
+++ b/src/worker/core/diagnostics/callback-flow.ts
@@ -0,0 +1,50 @@
+/** Opt-in, bounded control-flow telemetry. Never stores guest bytes or argument payloads. */
+export interface CallbackFlowEvent {
+    phase: 'frame-save' | 'callback-invoke' | 'callback-return' | 'frame-restore' |
+        'direct-restore' | 'com-create' | 'com-hle-result' | 'async-before' | 'async-after' | 'dialog-entry' | 'variant-init';
+    threadId: number;
+    eip?: number;
+    esp?: number;
+    targetEip?: number;
+    returnEip?: number;
+    expectedEsp?: number;
+    cleanupBytes?: number;
+    callbackId?: number;
+    frameId?: number;
+    stubAddress?: number;
+    depth?: number;
+    pointer?: number;
+    pointerValid?: boolean;
+    argCount?: number;
+    clsid?: string;
+    iid?: string;
+    result?: number;
+    objectPointer?: number;
+}
+export class CallbackFlowTrace {
+    private enabled = false;
+    private records: Array<CallbackFlowEvent & { sequence: number }> = [];
+    private sequence = 0;
+    private next = 0;
+    constructor(private readonly capacity = 128) {
+        if (!Number.isInteger(capacity) || capacity < 1 || capacity > 4096) throw new Error('Invalid callback trace capacity');
+    }
+    isEnabled(): boolean { return this.enabled; }
+    configure(enabled: boolean): void { this.enabled = enabled; this.clear(); }
+    clear(): void { this.records = []; this.sequence = 0; this.next = 0; }
+    record(event: CallbackFlowEvent): void {
+        if (!this.enabled) return;
+        this.records[this.next] = { ...event, sequence: ++this.sequence };
+        this.next = (this.next + 1) % this.capacity;
+    }
+    snapshot() {
+        const records = this.records.length === this.capacity
+            ? [...this.records.slice(this.next), ...this.records.slice(0, this.next)] : this.records;
+        return { enabled: this.enabled, dropped: Math.max(0, this.sequence - this.capacity),
+            events: records.map(event => ({ ...event })) };
+    }
+}
+export const callbackFlow = new CallbackFlowTrace();
+
+// Explicit local development opt-in; production builds are silent by default.
+if (import.meta.env?.VITE_BS_CALLBACK_FLOW === "1") callbackFlow.configure(true);
