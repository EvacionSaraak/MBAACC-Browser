+/** Handwritten synthetic x86, no game bytes. Runs the real v86 CPU and CallbackManager.
+ * The API entry is a modeless-dialog ABI seam, not the full user32 window implementation.
+ */
+import { expect, test } from 'bun:test';
+import { V86 } from '../../vendor/v86/build/libv86.mjs';
+import { CallbackManager } from '../../src/worker/core/thunking/callback-manager';
+import { System } from '../../src/worker/core/system';
+import { Mem } from '../../src/worker/core/memory/mem-accessor';
+import { Oleaut32 } from '../../src/worker/modules/oleaut32';
+import { callbackFlow } from '../../src/worker/core/diagnostics/callback-flow';
+
+test('nested modeless-dialog ABI callbacks call VariantInit and return to the original EIP/ESP', async () => {
+    const BASE = 0x100000, STACK = 0x300000, PORT = 0xb077;
+    const OUTER = BASE + 0x200, INNER = BASE + 0x300;
+    const DIALOG = BASE + 0x400, NESTED = BASE + 0x420, VARIANT = BASE + 0x440;
+    const image = new Uint8Array(0x1000), view = new DataView(image.buffer);
+    const MAGIC = 0x1badb002, FLAGS = 0x10000;
+    [MAGIC, FLAGS, -(MAGIC + FLAGS), BASE, BASE, BASE + image.length, BASE + image.length, BASE + 0x40]
+        .forEach((v, i) => view.setUint32(i * 4, v >>> 0, true));
+    let at = 0;
+    const emit = (...bytes: number[]) => { for (const b of bytes) image[at++] = b; };
+    const dword = (v: number) => { view.setUint32(at, v >>> 0, true); at += 4; };
+    const mov = (reg: number, value: number) => { emit(0xb8 + reg); dword(value); };
+    const call = (address: number) => { emit(0xe8); dword(address - (BASE + at + 4)); };
+    const args5 = () => { for (let i = 0; i < 5; i++) emit(0x6a, i); };
+    const variant = () => { emit(0x83, 0xec, 16, 0x54); call(VARIANT); emit(0x83, 0xc4, 16); };
+    at = 0x40;
+    mov(4, STACK); mov(3, 0x11223344); mov(6, 0x22334455); mov(7, 0x33445566); mov(5, 0x44556677);
+    args5(); call(DIALOG);
+    const DONE = BASE + at;
+    emit(0xf4, 0xeb, 0xfe);
+    at = OUTER - BASE;
+    emit(0x55, 0x89, 0xe5, 0x53, 0x56, 0x57); // save callee-saved registers
+    args5(); call(NESTED); variant();
+    emit(0x5f, 0x5e, 0x5b, 0x5d); mov(0, 1); emit(0xc2, 16, 0);
+    at = INNER - BASE;
+    emit(0x55, 0x89, 0xe5, 0x53, 0x56, 0x57); variant();
+    emit(0x5f, 0x5e, 0x5b, 0x5d); mov(0, 2); emit(0xc2, 16, 0);
+    for (const [address, id, pop] of [[DIALOG, 1, 20], [NESTED, 2, 20], [VARIANT, 3, 4]]) {
+        at = address - BASE;
+        mov(0, id!); mov(2, PORT); emit(0xef, 0xc2, pop!, 0);
+    }
+    const system = System.getInstance();
+    const saved = {process: system.process, scheduler: system.scheduler, exiting: system.isExiting};
+    const emulator = new V86({autostart: false, memory_size: 16 * 1024 * 1024, log_level: 0});
+    let manager: CallbackManager | undefined;
+    let variantCalls = 0, dialogs = 0;
+    callbackFlow.configure(true);
+    try {
+        await new Promise<void>((resolve, reject) => {
+            const timer = setTimeout(() => reject(new Error('Synthetic guest did not halt')), 5000);
+            emulator.bus.register('cpu-event-halt', () => { clearTimeout(timer); resolve(); });
+            emulator.add_listener('emulator-loaded', () => {
+                try {
+                    const cpu = emulator.v86.cpu;
+                    cpu.reboot_internal(); cpu.reset_memory(); cpu.load_multiboot(image.buffer);
+                    const mem = cpu.mem8 as Uint8Array;
+                    Mem.bind(() => mem);
+                    system.scheduler = {
+                        getCurrentThreadId: () => 1,
+                        getThreadStackBounds: () => ({base: STACK - 0x10000, top: STACK + 4}),
+                        pinCurrentThread() {}, unpinThread() {}, wakeCurrentThreadForCallbackDispatch() {},
+                        reportCallbackFrameFatal() { throw new Error('Callback frame fatal'); },
+                        reportFatalGuard() { throw new Error('Callback fatal guard'); },
+                    } as any;
+                    system.process = {addressSpace: {validateRange: (p: number, n: number) => p > 0 && p + n <= mem.length}} as any;
+                    system.isExiting = false;
+                    manager = new CallbackManager({cpu}, {} as any, () => mem);
+                    manager.initialize({getRegions: () => ({callbackStubPoolBase: 0x200000, callbackStubPoolSize: 0x4000})} as any);
+                    const oleaut = new Oleaut32();
+                    (oleaut as any).typeLibRuntime.initialize = () => {};
+                    oleaut.initialize({} as any);
+                    cpu.io.register_write(PORT, cpu, undefined, undefined, (id: number) => {
+                        try {
+                            const esp = cpu.reg32[4] >>> 0;
+                            if (manager!.isCallbackReturn(id >>> 0)) manager!.handleCallbackReturn(id >>> 0);
+                            else if (id === 3) {
+                                const ptr = new DataView(mem.buffer).getUint32(esp + 4, true);
+                                oleaut.exports.ord_8!({esp} as any, mem, [ptr]);
+                                variantCalls++;
+                                cpu.reg32[0] = 0;
