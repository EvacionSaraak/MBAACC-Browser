new file mode 100644
index 0000000..a608004
--- /dev/null
+++ b/tools/tests/callback-flow.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, test } from 'bun:test';
+import { CallbackFlowTrace } from '../../src/worker/core/diagnostics/callback-flow';
+
+describe('callback control-flow telemetry', () => {
+    test('disabled by default and bounded when armed', () => {
+        const ring = new CallbackFlowTrace(2);
+        ring.record({phase: 'frame-save', threadId: 1});
+        expect(ring.snapshot()).toEqual({enabled: false, dropped: 0, events: []});
+        ring.configure(true);
+        for (let i = 1; i <= 3; i++) ring.record({phase: 'frame-save', threadId: i});
+        expect(ring.snapshot().events.map(e => e.threadId)).toEqual([2, 3]);
+        expect(ring.snapshot().dropped).toBe(1);
+        ring.snapshot().events[0]!.threadId = 99;
+        expect(ring.snapshot().events[0]!.threadId).toBe(2);
+        ring.configure(false);
+        expect(ring.snapshot().events).toHaveLength(0);
+    });
+    test('rejects unbounded or invalid capacity', () => {
+        for (const n of [0, -1, 1.5, 4097, Infinity]) expect(() => new CallbackFlowTrace(n)).toThrow();
+    });
+});
