diff --git a/src/worker/modules/ole32-dxdiag.ts b/src/worker/modules/ole32-dxdiag.ts
new file mode 100644
index 0000000..9b50979
--- /dev/null
+++ b/src/worker/modules/ole32-dxdiag.ts
@@ -0,0 +1,159 @@
+/** Partial DxDiag over the emulated machine, never the host PC.
+ * ABI: Microsoft SDK dxdiag.h. Unknown properties/interfaces return errors.
+ */
+import type { Process } from '../core/process';
+import type { ThunkImplementation } from '../core/thunking/thunk-dispatcher';
+import { installComVtable, type ComVtableMethod } from '../core/com/install-com-vtable';
+import { readGuidFromMem } from '../core/com/typelib/typelib-types';
+import { isValidAddress } from '../core/memory/address-guard';
+import { adapterDescription, adapterDriverDll, adapterDriverVersion } from '../backends/webgpu/shared/dx-adapter-identifier';
+
+export const DXDIAG_CLSID = 'a65b8071-3bfe-4213-9a5b-491da4461ca7';
+export const DXDIAG_PROVIDER_IID = '9c6b4cb0-23f8-49cc-a3ed-45a55000a6d2';
+export const DXDIAG_CONTAINER_IID = '7d0f462f-4064-4862-bc7f-933e5058c10f';
+const UNKNOWN_IID = '00000000-0000-0000-c000-000000000046';
+const INVALID = 0x80070057, POINTER = 0x80004003, NO_INTERFACE = 0x80004002;
+const NO_MEMORY = 0x8007000e, NOT_INITIALIZED = 0x800401f0, SMALL_BUFFER = 0x8007007a;
+export interface DxNode { props: Record<string, string>; children: Record<string, DxNode> }
+export interface DxHost {
+    memory(): Uint8Array;
+    valid(ptr: number, size: number, write: boolean): boolean;
+    alloc(size: number): number;
+    free(ptr: number): void;
+    install(name: string, methods: ComVtableMethod[], handlers: Record<string, ThunkImplementation>): number;
+}
+interface ObjectState { refs: number; kind: 'provider' | 'container'; initialized: boolean; node: DxNode }
+export class DxDiag {
+    private objects = new Map<number, ObjectState>();
+    private tables = new Map<string, number>();
+    constructor(private host: DxHost, private root: DxNode) {}
+    reset(): void { this.objects.clear(); this.tables.clear(); }
+    private view(): DataView { const m = this.host.memory(); return new DataView(m.buffer, m.byteOffset, m.byteLength); }
+    private write(ptr: number, value: number): void { this.view().setUint32(ptr, value, true); }
+    private wide(ptr: number): string | null {
+        if (!ptr) return null;
+        let value = '';
+        for (let i = 0; i < 32768; i++) {
+            if (!this.host.valid(ptr + i * 2, 2, false)) return null;
+            const ch = this.view().getUint16(ptr + i * 2, true);
+            if (!ch) return value;
+            value += String.fromCharCode(ch);
+        }
+        return null;
+    }
+    private putWide(value: string, ptr: number, capacity: number): number {
+        if (!Number.isInteger(capacity) || capacity < 1 || capacity > 0x7fffffff || !this.host.valid(ptr, capacity * 2, true)) return INVALID;
+        if (capacity <= value.length) { this.view().setUint16(ptr, 0, true); return SMALL_BUFFER; }
+        for (let i = 0; i <= value.length; i++) this.view().setUint16(ptr + i * 2, i === value.length ? 0 : value.charCodeAt(i), true);
+        return 0;
+    }
+    create(iid: string, out: number): number {
+        if (!this.host.valid(out, 4, true)) return POINTER;
+        this.write(out, 0);
+        if (iid !== DXDIAG_PROVIDER_IID && iid !== UNKNOWN_IID) return NO_INTERFACE;
+        return this.publish('provider', this.root, out);
+    }
+    private publish(kind: 'provider' | 'container', node: DxNode, out: number): number {
+        const table = this.table(kind);
+        if (!table) return NO_MEMORY;
+        const ptr = this.host.alloc(4);
+        if (!ptr) return NO_MEMORY;
+        this.write(ptr, table);
+        this.objects.set(ptr, { refs: 1, kind, node, initialized: false });
+        this.write(out, ptr);
+        return 0;
+    }
+    private table(kind: 'provider' | 'container'): number {
+        const cached = this.tables.get(kind);
+        if (cached) return cached;
+        const definitions: [string, number][] = [['QueryInterface',3],['AddRef',1],['Release',1],
+            ...(kind === 'provider' ? [['Initialize',2],['GetRootContainer',2]] :
+                [['GetNumberOfChildContainers',2],['EnumChildContainerNames',4],['GetChildContainer',3],
+                 ['GetNumberOfProps',2],['EnumPropNames',4],['GetProp',3]]) as [string,number][]];
+        const handlers: Record<string, ThunkImplementation> = {};
+        const methods = definitions.map(([name,argCount]) => {
+            handlers[name] = (_ctx,_mem,args) => this.invoke(kind,name,args);
+            return {name,argCount,stackCleanupBytes:argCount*4};
+        });
+        const table = this.host.install(`ole32_dxdiag_${kind}`, methods, handlers);
+        if (table) this.tables.set(kind,table);
+        return table;
+    }
+    private invoke(kind: 'provider' | 'container', method: string, args: number[]): number {
+        const ptr = args[0] >>> 0, obj = this.objects.get(ptr);
+        if (!obj || obj.kind !== kind) return INVALID;
+        const a = args[1] >>> 0, b = args[2] >>> 0;
+        if (method === 'AddRef') return ++obj.refs;
+        if (method === 'Release') {
+            if (--obj.refs === 0) { this.objects.delete(ptr); this.host.free(ptr); return 0; }
+            return obj.refs;
+        }
+        if (method === 'QueryInterface') {
+            if (!this.host.valid(b,4,true)) return POINTER;
+            this.write(b,0);
+            if (!this.host.valid(a,16,false)) return POINTER;
+            const iid = readGuidFromMem(this.host.memory(),a);
+            if (iid !== UNKNOWN_IID && iid !== (kind === 'provider' ? DXDIAG_PROVIDER_IID : DXDIAG_CONTAINER_IID)) return NO_INTERFACE;
+            obj.refs++; this.write(b,ptr); return 0;
+        }
+        if (method === 'Initialize') {
+            if (!this.host.valid(a,16,false)) return INVALID;
+            const v = this.view();
+            if (v.getUint32(a,true) !== 16 || v.getUint32(a+4,true) !== 111 || v.getUint32(a+12,true) !== 0) return INVALID;
+            obj.initialized = true; return 0;
+        }
+        if (method === 'GetRootContainer') {
+            if (!this.host.valid(a,4,true)) return POINTER;
+            this.write(a,0);
+            return obj.initialized ? this.publish('container',obj.node,a) : NOT_INITIALIZED;
+        }
+        if (method === 'GetChildContainer') {
+            if (!this.host.valid(b,4,true)) return POINTER;
+            this.write(b,0);
+            const name = this.wide(a);
+            if (!name) return INVALID;
+            let node: DxNode | undefined = obj.node;
+            for (const part of name.split('.')) node = node && Object.hasOwn(node.children, part) ? node.children[part] : undefined;
+            return node ? this.publish('container',node,b) : INVALID;
+        }
+        const names = Object.keys(method.includes('Prop') ? obj.node.props : obj.node.children);
+        if (method.startsWith('GetNumberOf')) {
+            if (!this.host.valid(a,4,true)) return POINTER;
+            this.write(a,names.length); return 0;
+        }
+        if (method.startsWith('Enum')) return a < names.length ? this.putWide(names[a],b,args[3] >>> 0) : INVALID;
+        if (method === 'GetProp') {
+            if (!this.host.valid(b,16,true)) return POINTER;
+            const name = this.wide(a);
+            if (name === null || !Object.hasOwn(obj.node.props,name)) return INVALID;
+            const value = obj.node.props[name];
+            const allocation = this.host.alloc(4 + (value.length+1)*2);
+            if (!allocation) return NO_MEMORY;
+            this.write(allocation,value.length*2);
+            this.putWide(value,allocation+4,value.length+1);
+            const mem = this.host.memory(); mem.fill(0,b,b+16);
+            this.view().setUint16(b,8,true); // VT_BSTR; owned by caller / VariantClear.
+            this.write(b+8,allocation+4);
+            return 0;
+        }
+        return INVALID;
+    }
+}
+export function createDxDiag(process: Process): DxDiag {
+    const version = adapterDriverVersion();
+    const driverVersion = [48n,32n,16n,0n].map(shift => Number((version >> shift) & 0xffffn)).join('.');
+    const display: DxNode = {props: {
+        szDescription: adapterDescription(), szDriverName: adapterDriverDll(), szDriverVersion: driverVersion,
+    }, children:{}};
+    const root: DxNode = {props:{},children:{
+        DxDiag_SystemInfo: {props:{szProcessorEnglish:'BottleShip x86 emulator'},children:{}},
+        DxDiag_DisplayDevices: {props:{},children:{'0':display}},
+    }};
+    return new DxDiag({
+        memory: () => process.getCurrentMemory(),
+        valid: (ptr,size,write) => !!ptr && isValidAddress(process.getCurrentMemory(),ptr,size,write ? 'rw' : 'r'),
+        alloc: size => process.memory.alloc(size),
+        free: ptr => { process.memory.free(ptr); },
+        install: (moduleName,methods,handlers) => installComVtable(process,{moduleName,methods,handlers})?.vtableAddr ?? 0,
+    },root);
+}
