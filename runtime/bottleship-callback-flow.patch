@@ -0,0 +1,69 @@
+import { expect, test } from 'bun:test';
+import { DxDiag, DXDIAG_PROVIDER_IID, DXDIAG_CONTAINER_IID } from '../../src/worker/modules/ole32-dxdiag';
+import { writeGuidToMem } from '../../src/worker/core/com/typelib/typelib-types';
+
+function harness() {
+    const memory = new Uint8Array(0x10000), view = new DataView(memory.buffer);
+    const tables = new Map<number, any>(), freed: number[] = []; let next = 0x1000;
+    const diag = new DxDiag({
+        memory:()=>memory, valid:(p,n)=>p>0 && n>=0 && p+n<=memory.length,
+        alloc:n=>{const p=next;next+=Math.ceil(n/4)*4;return p;}, free:p=>{freed.push(p);},
+        install:(_name,methods,handlers)=>{const p=next;next+=128;tables.set(p,{methods,handlers});return p;},
+    },{props:{},children:{DxDiag_SystemInfo:{props:{szProcessorEnglish:'Virtual CPU'},children:{}}}});
+    const call=(p:number,name:string,...args:number[])=>tables.get(view.getUint32(p,true)).handlers[name]({},memory,[p,...args]);
+    const wide=(p:number,s:string)=>{for(let i=0;i<=s.length;i++)view.setUint16(p+i*2,s.charCodeAt(i)||0,true);};
+    return {diag,memory,view,call,wide,tables,freed};
+}
+test('DxDiag initialization, child enumeration and owned BSTR property',()=>{
+    const h=harness(); expect(h.diag.create(DXDIAG_PROVIDER_IID,0x100)).toBe(0);
+    const provider=h.view.getUint32(0x100,true);
+    expect(h.call(provider,'GetRootContainer',0x104)).toBe(0x800401f0);
+    expect(h.view.getUint32(0x104,true)).toBe(0);
+    h.view.setUint32(0x200,16,true);h.view.setUint32(0x204,111,true);
+    expect(h.call(provider,'Initialize',0x200)).toBe(0);
+    expect(h.call(provider,'GetRootContainer',0x104)).toBe(0);
+    const root=h.view.getUint32(0x104,true);
+    expect(h.call(root,'GetNumberOfChildContainers',0x108)).toBe(0);
+    expect(h.view.getUint32(0x108,true)).toBe(1);
+    expect(h.call(root,'EnumChildContainerNames',0,0x300,2)).toBe(0x8007007a);
+    expect(h.call(root,'EnumChildContainerNames',1,0x300,100)).toBe(0x80070057);
+    expect(h.call(root,'EnumChildContainerNames',0,0x300,100)).toBe(0);
+    expect(h.call(root,'GetChildContainer',0x300,0x10c)).toBe(0);
+    const child=h.view.getUint32(0x10c,true);
+    for (const name of ['__proto__', 'constructor', 'toString']) {
+        h.wide(0x300,name);
+        expect(h.call(root,'GetChildContainer',0x300,0x110)).toBe(0x80070057);
+        expect(h.view.getUint32(0x110,true)).toBe(0);
+    }
+    h.wide(0x300,'szProcessorEnglish');expect(h.call(child,'GetProp',0x300,0x400)).toBe(0);
+    expect(h.view.getUint16(0x400,true)).toBe(8);
+    const bstr=h.view.getUint32(0x408,true);
+    expect(h.view.getUint32(bstr-4,true)).toBe(22);
+    expect(new TextDecoder('utf-16le').decode(h.memory.slice(bstr,bstr+22))).toBe('Virtual CPU');
+    expect(h.view.getUint16(bstr+22,true)).toBe(0);
+    h.wide(0x300,'unknown');expect(h.call(child,'GetProp',0x300,0x400)).toBe(0x80070057);
+    expect(h.call(provider,'Release')).toBe(0);
+    // A container keeps its own lifetime when the provider is released.
+    expect(h.call(child,'GetNumberOfProps',0x108)).toBe(0);
+    expect(h.call(child,'Release')).toBe(0);expect(h.freed).toContain(child);
+    expect(h.call(root,'Release')).toBe(0);
+    for(const {methods} of h.tables.values()) for(const m of methods) expect(m.stackCleanupBytes).toBe(m.argCount*4);
+});
+test('DxDiag rejects invalid pointers, header, reserved field and unsupported interfaces',()=>{
+    const h=harness();expect(h.diag.create(DXDIAG_PROVIDER_IID,0)).toBe(0x80004003);
+    expect(h.diag.create(DXDIAG_CONTAINER_IID,0x100)).toBe(0x80004002);
+    expect(h.view.getUint32(0x100,true)).toBe(0);
+    h.diag.create(DXDIAG_PROVIDER_IID,0x100);const provider=h.view.getUint32(0x100,true);
+    expect(h.call(provider,'Initialize',0xfffc)).toBe(0x80070057);
+    h.view.setUint32(0x200,16,true);h.view.setUint32(0x204,110,true);
+    expect(h.call(provider,'Initialize',0x200)).toBe(0x80070057);
+    h.view.setUint32(0x204,111,true);h.view.setUint32(0x20c,1,true);
+    expect(h.call(provider,'Initialize',0x200)).toBe(0x80070057);
+    writeGuidToMem(h.memory,0x300,DXDIAG_CONTAINER_IID);
+    expect(h.call(provider,'QueryInterface',0x300,0x104)).toBe(0x80004002);
+    writeGuidToMem(h.memory,0x300,DXDIAG_PROVIDER_IID);
+    expect(h.call(provider,'QueryInterface',0x300,0x104)).toBe(0);
+    expect(h.view.getUint32(0x104,true)).toBe(provider);
+    expect(h.call(provider,'Release')).toBe(1);expect(h.call(provider,'Release')).toBe(0);
+    h.diag.reset();expect(h.call(provider,'AddRef')).toBe(0x80070057);
+});
diff --git a/tools/tests/nested-dialog-x86.test.ts b/tools/tests/nested-dialog-x86.test.ts
